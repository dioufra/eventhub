# =============================================================================
#  EventHub — modèle de configuration
#
#  Copier en .env puis renseigner les valeurs :   cp .env.example .env
#  Le fichier .env ne doit JAMAIS être commité (il est dans .gitignore).
# =============================================================================

# ---- Base de données --------------------------------------------------------
POSTGRES_USER=eventhub
# Générer une vraie valeur avec :  openssl rand -base64 24
POSTGRES_PASSWORD=changez-moi-en-mot-de-passe-fort

# ---- Exposition -------------------------------------------------------------
# Port par lequel on accède à l'application depuis le navigateur.
# C'est la GATEWAY qui écoute ici : ni le frontend ni les services
# ne publient de port (architecture B).
GATEWAY_PORT=8080

# ---- Journalisation ---------------------------------------------------------
# DEBUG en développement, INFO en production.
LOG_LEVEL=INFO

# ---- Registre d'images ------------------------------------------------------
# En local : laisser "eventhub".
# En production : ghcr.io/dioufra
REGISTRY=eventhub
TAG=latest
