{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "spec:events": "curl -sf http://localhost:8001/openapi.json -o openapi/events.json",
    "spec:participants": "curl -sf http://localhost:8002/openapi.json -o openapi/participants.json",
    "spec:registrations": "curl -sf http://localhost:8003/openapi.json -o openapi/registrations.json",
    "spec:all": "npm run spec:events && npm run spec:participants && npm run spec:registrations",
    "gen:events": "openapi-generator-cli generate -i ./openapi/events.json -g typescript-angular -o src/app/core/api/events --additional-properties=ngVersion=20,providedInRoot=true,withInterfaces=true",
    "gen:participants": "openapi-generator-cli generate -i ./openapi/participants.json -g typescript-angular -o src/app/core/api/participants --additional-properties=ngVersion=20,providedInRoot=true,withInterfaces=true",
    "gen:registrations": "openapi-generator-cli generate -i ./openapi/registrations.json -g typescript-angular -o src/app/core/api/registrations --additional-properties=ngVersion=20,providedInRoot=true,withInterfaces=true",
    "gen:all": "npm run gen:events && npm run gen:participants && npm run gen:registrations",
    "api:refresh": "npm run spec:all && npm run gen:all"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.33",
    "@angular/cli": "^20.3.33",
    "@angular/compiler-cli": "^20.3.0",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}